{
  "comments": {
    "lineComment": "'",
    "blockComment": ["/'", "'/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(@start\\w+|package\\b.*\\{|namespace\\b.*\\{|.*\\{\\s*$)",
      "end": "^\\s*(@end\\w+|\\})"
    }
  }
}
